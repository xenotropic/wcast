{
  "name": "Wcast Android Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "fwcd.kotlin",
        "mathiasfrohlich.Kotlin"
      ]
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=wcast-vscode-server,target=/home/vscode/.vscode-server,type=volume"
  ],
  "containerEnv": {
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "postStartCommand": "sudo iptables -A OUTPUT -p tcp --dport 5555 -j DROP; git config --global credential.helper 'cache --timeout=28800'"
}
