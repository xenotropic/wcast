{
  "name": "Wcast Android Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev",
        "fwcd.kotlin",
        "mathiasfrohlich.Kotlin"
      ]
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=wcast-vscode-server,target=/home/vscode/.vscode-server,type=volume"
  ],
  "postStartCommand": "sudo iptables -A OUTPUT -p tcp --dport 5555 -j DROP"
}