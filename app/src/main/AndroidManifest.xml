<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required (Android 13+) to show the media notification. On older
         versions notifications are implicitly permitted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to run the playback service in the foreground so the system keeps
         this app as the media-button target (like Spotify/AntennaPod's service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Allow the app to query and bind to installed TTS engines (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wcast">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".BookmarksActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Foreground playback service: owns the framework MediaSession so wired/
             Bluetooth headset buttons (and lock-screen/drawer controls) reach this
             app even when the UI isn't foregrounded, matching how Spotify and
             AntennaPod handle media keys. Started explicitly via
             startForegroundService, so no intent-filter is needed. -->
        <service
            android:name=".tts.WcastMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Receives button taps from the media notification (stop / previous /
             play-pause / next) and routes them to the active media session. -->
        <receiver
            android:name=".tts.MediaControlReceiver"
            android:exported="false" />
    </application>

</manifest>